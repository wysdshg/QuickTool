logs/
*.log

# 虚拟环境
.venv/

# 系统与编辑器垃圾文件
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
.idea/
.vscode/

# 测试临时产物（portable_check 沙箱副本 / 临时取证脚本，非常规源码）
tests/_portable_sandbox/
tests/_diag_events_tmp.py
tests/_proc_check_tmp.py
